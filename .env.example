# Mi Pueblo Digital · Gran Consejo Comunitario Río Satinga
#
# Copia este archivo como `.env` y rellena lo que falte. Nada que empiece por
# NEXT_PUBLIC_ es secreto: viaja al navegador. Lo demás no sale del servidor.

# --- Firebase, del lado del navegador -----------------------------------
# Consola de Firebase → Configuración del proyecto → Tus aplicaciones (Web).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# El número del proyecto, que el SDK web necesita para los avisos push.
# Está en google-services.json como `project_number`.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Clave pública para los avisos push en el navegador. Consola de Firebase →
# Configuración del proyecto → Cloud Messaging → Certificados push web →
# Generar par de claves. Si se deja vacía, el navegador sencillamente no
# ofrece avisos y la aplicación instalada sigue funcionando igual.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Solo en desarrollo, contra los emuladores locales. En producción: false.
NEXT_PUBLIC_FIREBASE_EMULATORS=false

# --- Firebase, del lado del servidor ------------------------------------
# Credenciales privadas del proyecto. Una de las dos, no las dos.
# En el equipo de desarrollo, la ruta al archivo JSON:
GOOGLE_APPLICATION_CREDENTIALS=
# En la nube (Vercel, Render…), el contenido del JSON o su Base64:
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Archivo de evidencias (Supabase) -----------------------------------
# Las fotografías originales viven aquí. La clave nunca sale del servidor.
SUPABASE_URL=
# La nueva (sb_secret_…). Si el proyecto todavía usa la anterior, usa la de
# abajo: el servidor acepta cualquiera de las dos.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Asistente de redacción (OpenRouter) --------------------------------
# Opcional: sin clave, la aplicación funciona y el borrador de IA no aparece.
# Solo se admiten modelos gratuitos; el servidor rechaza cualquier otro.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Publicación comunitaria --------------------------------------------
# Horas de gracia antes de que un reporte no marcado como delicado conste ante
# la comunidad. Es el margen que tiene quien reportó para reservarlo.
# Entre 1 y 720; si falta o es inválido, 24.
PUBLIC_REPORT_DELAY_HOURS=24
