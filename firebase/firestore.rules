rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function active() {
      return request.auth != null && exists(/databases/$(database)/documents/accounts/$(request.auth.uid)) && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.active == true;
    }
    function admin() { return active() && request.auth.token.admin == true; }
    match /accounts/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    // El retrato vive aparte del documento de la cuenta: ese se lee en cada
    // peticion autenticada y no debe arrastrar decenas de kilobytes de imagen.
    // Se sirve por la API, que comprueba quien pide; desde el navegador, nada.
    match /avatars/{uid} {
      allow read, write: if false;
    }
    // Copia reducida de la fotografia de un reporte, por si el archivo externo
    // no responde. Aparte del expediente porque este se lista de 25 en 25.
    // Se sirve por la API, que comprueba dueno o rol; desde el navegador, nada.
    match /incidentEvidence/{id} {
      allow read, write: if false;
    }
    // Portada fotografica de un comunicado. Aparte del comunicado porque la
    // redaccion lista cien de una vez y ninguno debe arrastrar la imagen en
    // esa consulta. Se sirve por la API, que antes comprueba que este
    // publicado; asi la portada de un borrador no se ve adivinando la
    // direccion.
    match /newsCovers/{id} {
      allow read, write: if false;
    }
    match /incidents/{id} {
      // Private cases, originals and internal notes are served by authenticated APIs.
      // Server SDK bypasses rules; all authorization is also enforced in those APIs.
      allow get, list: if false;
      allow write: if false;
    }
    match /publicIncidents/{id} {
      // The API applies the 24-hour embargo and sensitivity check against the
      // live private case. Direct SDK reads could bypass both checks.
      allow get, list: if false;
      allow write: if false;
    }
    // Los aparatos que reciben avisos. Se escriben solo desde /api/push/,
    // con el SDK de servidor. Aqui se deniega explicitamente para que quien
    // lea estas reglas no tenga que deducirlo de la regla comodin de abajo.
    // Los puntos de vereda que el Consejo acepto a partir de los reportes de
    // quien vive alli. Los lee cualquier miembro porque son el mapa del
    // territorio; escribirlos es cosa de /api/admin/territorio/, con el SDK de
    // servidor. Llevan nombre, punto y fuente: nada de quien los aporto.
    match /veredaPoints/{vereda} {
      allow get, list: if active();
      allow write: if false;
    }
    // El acumulador con los aportes crudos no sale del servidor: lleva las
    // coordenadas de cada reporte y de que cuenta salio cada una.
    match /veredaProposals/{vereda} {
      allow read, write: if false;
    }
    match /pushTokens/{uid}/devices/{token} {
      allow read, write: if false;
    }
    // Archivos de exportacion ya calculados en el aparato (CSV, informe),
    // a la espera de que el navegador del sistema los recoja por su billete.
    // Se escriben y se leen solo desde /api/statistics/export/, con el SDK
    // de servidor.
    match /exportTickets/{ticket} {
      allow read, write: if false;
    }
    // Historia y auditoría se leen/publican exclusivamente mediante el servidor.
    match /councilHistory/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
