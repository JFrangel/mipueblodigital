<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Los avisos que llegan con la aplicación cerrada.
             La silueta tiene que ser blanca sobre transparente: con un icono a
             color Android enseña un cuadrado blanco, que es lo que hace que una
             aplicación parezca rota en la barra de arriba. La genera
             scripts/iconos-android.mjs desde public/brand/notify-mark.svg. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/mpd_aviso" />
        <!-- El canal lo crea src/platform/push.ts con su nombre en español.
             Sin esta línea, los avisos caen en uno que la gente ve en los
             ajustes del teléfono como «Miscellaneous». -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/mpd_canal_avisos" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permisos -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- El dictado. Sin esta línea Android negaba la petición del micrófono
         **sin enseñar ningún diálogo**, y la persona leía «no se autorizó el
         micrófono» sin haber tenido nunca nada que autorizar. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Lo pide el reconocedor de voz de Android para saber qué motores hay
         instalados; sin esto no encuentra ninguno en Android 11 en adelante. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- «Usar mi ubicación» en el reporte. Las dos: con el permiso fino se
         sitúa un derrumbe, y con el grueso al menos el sector, que es mejor que
         nada cuando alguien no quiere dar el fino. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Y **no** ACCESS_BACKGROUND_LOCATION, a propósito y por escrito para que
         nadie lo añada por si acaso. Esta aplicación solo necesita saber dónde
         está alguien mientras esa persona mira el formulario y ha pulsado un
         botón. Pedir la ubicación en segundo plano es una promesa que no hay
         que hacerle a una comunidad sobre dónde están sus miembros, y además es
         de las cosas por las que Google Play rechaza una aplicación. -->
</manifest>
