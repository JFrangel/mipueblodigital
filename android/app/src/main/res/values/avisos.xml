<?xml version="1.0" encoding="utf-8"?>
<!--
  Lo que Android necesita saber de los avisos antes de que la aplicación
  arranque: de qué color tiñe el icono en la bandeja de notificaciones y a qué
  canal van los que llegan sin decirlo.

  El canal en sí lo crea `src/platform/push.ts` al apuntar el aparato, que es
  donde puede llevar su nombre y su descripción en español. Sin este
  identificador aquí, Android manda los avisos a un canal propio que la gente ve
  en los ajustes del teléfono como «Miscellaneous».
-->
<resources>
    <!-- El verde del Consejo, el mismo de la barra de estado y del manifiesto
         web. Tiñe la silueta del palafito en la bandeja. -->
    <color name="mpd_aviso">#16583F</color>
    <!-- El color del arranque: el azul del río de noche, el mismo del fondo del
         icono. Lo piden la pantalla del sistema y el fondo de la ventana, y
         tiene que ser el mismo en los dos: si no, al pasar de una a otra se ve
         un cambio de color donde no ocurre nada. Es también el de
         `backgroundColor` en `capacitor.config.ts`.

         **Uno solo, y el mismo en los dos temas.** Esta pantalla se pinta antes
         de que exista la web, así que no puede saber qué tema eligió alguien
         dentro de la aplicación: eso vive en el navegador. Se probó hacerla
         seguir al tema del teléfono con `values-night`, y no arregla nada —el
         tema del teléfono y el de la aplicación pueden no coincidir, y entonces
         el desacuerdo se ve igual—. Con un color para todos no hay nada que
         coordinar, y el que vale es el azul, que es el único que esta pantalla
         puede garantizar. -->
    <color name="mpd_arranque">#0d3340</color>
    <string name="mpd_canal_avisos" translatable="false">consejo</string>
</resources>
