{
  "name": "mi-pueblo-digital",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "seed:noticias": "node scripts/sembrar-noticias.mjs",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "cap:apk": "cd android && gradlew.bat assembleRelease",
    "test:rules": "firebase emulators:exec --only firestore --project demo-mi-pueblo \"node tests/integration/rules.mjs\""
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-firebase/authentication": "^8.5.1",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "firebase": "12.18.0",
    "firebase-admin": "14.3.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "6.2.5",
    "firebase-tools": "15.29.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "type": "module",
  "overrides": {
    "jose": "^5"
  }
}
